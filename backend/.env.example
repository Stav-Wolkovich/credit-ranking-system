# SMTP configuration for the notification system's email channel.
# Copy this file to backend/.env and fill in real values — .env is
# gitignored, so credentials here never get committed.
#
# Gmail: smtp.gmail.com, port 587, requires an App Password (not your
#   regular password) — https://myaccount.google.com/apppasswords
# Outlook/Microsoft 365: smtp.office365.com, port 587
# A company mail server or a transactional-email provider's SMTP relay
#   (SendGrid, Mailgun, etc.) will give you their own host/port/credentials.

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Set to false only if your provider needs a plain (non-STARTTLS) connection.
SMTP_USE_TLS=true
